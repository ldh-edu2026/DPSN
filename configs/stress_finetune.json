{
  "model": {
    "type_map": ["Si", "N"],
    "descriptor": {
      "type": "se_e2_a",
      "sel": [100, 200],
      "rcut": 6.0,
      "rcut_smth": 0.5,
      "neuron": [25, 50, 100],
      "axis_neuron": 16,
      "resnet_dt": false,
      "seed": 1,
      "activation_function": "tanh"
    },
    "fitting_net": {
      "neuron": [200, 200, 200],
      "resnet_dt": true,
      "seed": 1,
      "activation_function": "tanh"
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.0001,
    "stop_lr": 1e-8,
    "decay_steps": 2000
  },
  "loss": {
    "type": "ener",
    "start_pref_e": 0.02,
    "limit_pref_e": 1.0,
    "start_pref_f": 1000,
    "limit_pref_f": 1.0,
    "start_pref_v": 0.001,
    "limit_pref_v": 0.01
  },
  "training": {
    "training_data": {
      "systems": ["./train_set"],
      "batch_size": 16
    },
    "validation_data": {
      "systems": ["./val_set"],
      "batch_size": 16
    },
    "numb_steps": 10000,
    "disp_file": "lcurve_stress_finetune.out",
    "disp_freq": 100,
    "save_freq": 1000,
    "seed": 1,
    "save_ckpt": "model_stress_finetuned.ckpt"
  }
}
